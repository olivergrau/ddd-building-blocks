{
  "version": "2.0.0",
  "tasks": [
    { "label": "restore", "type": "process", "command": "dotnet", "args": ["restore", "DDD.BuildingBlocks.sln"] },
    { "label": "build", "type": "process", "command": "dotnet", "args": ["build", "DDD.BuildingBlocks.sln", "--no-restore"] },
    { "label": "test-fast", "type": "process", "command": "dotnet", "args": ["test", "DDD.BuildingBlocks.sln", "--no-build", "--filter", "Category!=Integration"] },
    { "label": "test-integration", "type": "process", "command": "dotnet", "args": ["test", "DDD.BuildingBlocks.sln", "--no-build", "--filter", "Category=Integration"] },
    { "label": "test-all", "type": "process", "command": "dotnet", "args": ["test", "DDD.BuildingBlocks.sln", "--no-build"] },
    { "label": "format-check", "type": "process", "command": "dotnet", "args": ["format", "DDD.BuildingBlocks.sln", "--verify-no-changes"] },
    { "label": "pack", "type": "process", "command": "dotnet", "args": ["pack", "DDD.BuildingBlocks.sln", "--no-build", "--configuration", "Debug"] },
    { "label": "clean", "type": "process", "command": "dotnet", "args": ["clean", "DDD.BuildingBlocks.sln"] }
  ]
}
